@page "/agents/configuration"
@attribute [Authorize(Policy = AgentsFrontComposerRegistration.AgentsAdministratorPolicy)]
@implements IDisposable
@inject IStringLocalizer<AgentsResources> Localizer
@inject IAgentSetupGateway Gateway
@inject TimeProvider TimeProvider
@inject IUlidFactory UlidFactory
@inject AgentSetupAttemptStore AttemptStore
@inject AuthenticationStateProvider Authentication

@* hexa configuration (AC4, AC5, AC6; Story 5.2): a constrained Fluent form (UX-DR15). Identity/instructions/
   provider/content-safety surface presence/validity/version only — never the instruction text or policy content
   (AD-14). The response mode uses a mutually-exclusive radio group whose copy states the change affects future
   Agent Calls only. Writes go through the live gateway and report the truth stage they actually reached:
   submitted → authoritative-pending → projection-confirmed. Lifecycle Active is rendered as a lifecycle flag and
   never as callability. *@
<FcPageLayout Mode="FcPageLayoutMode.Constrained">
    <FcContentLabel LabelledBy="@HeadingId" />
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="24px" Class="agents-config" data-testid="agents-config">
        <FcPageHeader @ref="_header"
                      PageTitle="@Localizer["Agents.Config.Title"]"
                      Heading="@Localizer["Agents.Config.Title"]"
                      HeadingId="@HeadingId"
                      HeadingTabIndex="-1"
                      Eyebrow="@Localizer["Agents.Config.Eyebrow"]"
                      Description="@Localizer["Agents.Config.Description"]"
                      TestId="agents-config-header" />

        @if (_authenticationPending)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Loading" TestId="agents-config-state" />
        }
        else
        {
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="8px"
                     role="status"
                     aria-live="polite"
                     aria-atomic="true"
                     data-testid="agents-config-write-live-region">
            @if (_writeAnnouncementKey is { } announcementKey)
            {
                <FluentText data-testid="agents-config-write-state">
                    @Localizer[announcementKey]
                </FluentText>
            }
            else if (_pendingWrite is { } pendingStatus)
            {
                <FluentText data-testid="agents-config-write-state">
                    @Localizer[$"Agents.Config.Write.{pendingStatus.Status}"]
                </FluentText>
            }
        </FluentStack>
        @if (HasUnresolvedAttempt)
        {
            <FluentText data-testid="agents-config-write-lifetime">@Localizer["Agents.Config.Write.Lifetime"]</FluentText>
        }
        @if (_pendingWrite is { } pending && _activeAttempt is not null)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px" data-testid="agents-config-write-recovery">
                @if (pending.Status == AgentSetupWriteStatus.AwaitingProjection
                    && pending.TargetConfigurationVersion is not null)
                {
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@_busy"
                                  OnClick="RefreshPendingAsync"
                                  data-testid="agents-config-write-refresh">
                        @Localizer["Agents.Config.Write.Refresh"]
                    </FluentButton>
                }
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@_busy"
                              OnClick="RetryAttemptAsync"
                              data-testid="agents-config-write-retry">
                    @Localizer["Agents.Config.Write.Retry"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              Disabled="@_busy"
                              OnClick="AbandonAttempt"
                              data-testid="agents-config-write-abandon">
                    @Localizer["Agents.Config.Write.Abandon"]
                </FluentButton>
            </FluentStack>
        }

        @if (!HasUnresolvedAttempt && !_draftReadRecovery && _result is { Status: AgentInspectionStatus.Success,
            Setup.TruthState: AgentSetupTruthState.AuthoritativePending })
        {
            <FluentText data-testid="agents-config-authority-pending">@Localizer["Agents.Config.Write.AuthorityPending"]</FluentText>
            <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@_busy"
                          OnClick="RefreshAuthorityAsync" data-testid="agents-config-authority-refresh">
                @Localizer["Agents.Config.Write.Refresh"]
            </FluentButton>
        }

        @if (_draftReadRecovery && AttemptStore.IsCurrent(_scope))
        {
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Disabled="@(_busy || HasUnresolvedAttempt)"
                          OnClick="RefreshAuthorityAsync"
                          data-testid="agents-config-draft-refresh">
                @Localizer["Agents.Config.Write.Refresh"]
            </FluentButton>
        }

        @if (_result is null)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Loading" TestId="agents-config-state" />
        }
        else if (_result.Status is AgentInspectionStatus.NotAuthorized)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.PermissionDenied" TestId="agents-config-state" />
        }
        else if (_result.Status is AgentInspectionStatus.Unavailable
            || Gateway is DeferredAgentSetupGateway
            || _result.Setup is { TruthState: AgentSetupTruthState.Unknown or AgentSetupTruthState.Submitted })
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Unavailable" TestId="agents-config-state" />
        }
        else if (_result.Status is AgentInspectionStatus.AgentNotFound || _result.Setup is null)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Empty" TestId="agents-config-state" />
        }
        else
        {
            AgentSetupView setup = _result.Setup;
            AgentStatusView agent = setup.Agent;

            @if (HasDivergentDraft)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px" data-testid="agents-config-draft-divergence">
                    <FluentText role="status">@Localizer["Agents.Config.Draft.Diverged"]</FluentText>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(_busy || HasUnresolvedAttempt)"
                                  OnClick="LoadSavedValuesAsync"
                                  data-testid="agents-config-load-saved">
                        @Localizer["Agents.Config.Draft.LoadSaved"]
                    </FluentButton>
                </FluentStack>
            }
            <FluentAccordion HeadingLevel="2" data-testid="agents-config-sections">
                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Identity"]" @bind-Expanded="_expandedSections[0]">
                    <dl>
                        <dt>@Localizer["Agents.Config.DisplayName.Label"]</dt>
                        <dd data-testid="agents-config-display-name">@(string.IsNullOrEmpty(agent.DisplayName) ? Localizer["Agents.Common.None"] : agent.DisplayName)</dd>
                        <dt>@Localizer["Agents.Config.Description.Label"]</dt>
                        <dd data-testid="agents-config-description">@(string.IsNullOrEmpty(agent.Description) ? Localizer["Agents.Common.None"] : agent.Description)</dd>
                    </dl>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Instructions"]" @bind-Expanded="_expandedSections[1]">
                    <ul>
                        <li data-testid="agents-config-instructions-presence">@(agent.HasInstructions ? Localizer["Agents.Config.Instructions.Present"] : Localizer["Agents.Config.Instructions.Absent"])</li>
                        @if (agent.HasInstructions)
                        {
                            <li data-testid="agents-config-instructions-validity">@(agent.InstructionsValid ? Localizer["Agents.Config.Instructions.Valid"] : Localizer["Agents.Config.Instructions.Invalid"])</li>
                            <li data-testid="agents-config-instructions-version">@Localizer["Agents.Config.Instructions.Version", agent.InstructionsVersion]</li>
                        }
                    </ul>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Edit"]" @bind-Expanded="_expandedSections[2]">
                    @* The only write surface for identity and instructions. The instructions field starts empty on a cold load
                       and is cleared while a submit is owned by the retained attempt; terminal failure or abandonment
                       restores that exact draft. The current instruction text is never read back into the page, so a
                       save reports presence/validity/version and nothing else (AD-14). *@
                    <FluentTextInput @bind-Value="_displayNameDraft"
                                     Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt)"
                                     Label="@Localizer["Agents.Config.DisplayName.Label"]"
                                     AriaLabel="@Localizer["Agents.Config.DisplayName.Label"]"
                                     data-testid="agents-config-display-name-input" />
                    <FluentTextInput @bind-Value="_descriptionDraft"
                                     Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt)"
                                     Label="@Localizer["Agents.Config.Description.Label"]"
                                     AriaLabel="@Localizer["Agents.Config.Description.Label"]"
                                     data-testid="agents-config-description-input" />
                    <FluentTextArea @bind-Value="_instructionsDraft"
                                    Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt)"
                                    Label="@Localizer["Agents.Config.Instructions.Label"]"
                                    AriaLabel="@Localizer["Agents.Config.Instructions.Label"]"
                                    Required="true"
                                    data-testid="agents-config-instructions-input" />
                    <p class="agents-config__note" data-testid="agents-config-instructions-write-note">
                        @Localizer["Agents.Config.Instructions.ReplaceNote"]
                    </p>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt || string.IsNullOrWhiteSpace(_instructionsDraft))"
                                  OnClick="SubmitConfigurationAsync"
                                  data-testid="agents-config-submit">
                        @Localizer["Agents.Config.Edit.Submit"]
                    </FluentButton>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Provider"]" @bind-Expanded="_expandedSections[3]">
                    <p data-testid="agents-config-provider">
                        @if (agent.HasProviderSelection && agent.SelectedProviderId is { } providerId && agent.SelectedModelId is { } modelId)
                        {
                            <code>@Localizer["Agents.Config.Provider.Selected", providerId, modelId]</code>
                        }
                        else
                        {
                            @Localizer["Agents.Config.Provider.None"]
                        }
                    </p>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Truth"]" @bind-Expanded="_expandedSections[4]">
                    <dl>
                        <dt>@Localizer["Agents.Config.Truth.Stage.Label"]</dt>
                        <dd data-testid="agents-config-truth-stage">@Localizer[$"Agents.Config.Truth.Stage.{setup.TruthState}"]</dd>
                        <dt>@Localizer["Agents.Config.Truth.ConfigurationVersion.Label"]</dt>
                        <dd data-testid="agents-config-configuration-version">@setup.ConfigurationVersion</dd>
                        <dt>@Localizer["Agents.Config.Truth.ProjectionVersion.Label"]</dt>
                        <dd data-testid="agents-config-projection-version">@(setup.ProjectionVersion ?? Localizer["Agents.Common.None"].Value)</dd>
                        <dt>@Localizer["Agents.Config.Truth.Freshness.Label"]</dt>
                        <dd data-testid="agents-config-freshness">@Localizer[$"Agents.Config.Truth.Freshness.{setup.Freshness}"]</dd>
                    </dl>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.ResponseMode"]" @bind-Expanded="_expandedSections[5]">
                    <ResponseModeToggle Value="@_responseMode" ValueChanged="OnResponseModeChanged" Name="agents-config-response-mode" Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt)" />
                    <p class="agents-config__note">@Localizer["Agents.Config.ResponseMode.FutureOnlyNote"]</p>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt || _responseMode == agent.ResponseMode)"
                                  OnClick="SubmitResponseModeAsync"
                                  data-testid="agents-config-response-mode-submit">
                        @Localizer["Agents.Config.ResponseMode.Submit"]
                    </FluentButton>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.ApproverPolicy"]" @bind-Expanded="_expandedSections[6]">
                    <p data-testid="agents-config-approver-presence">@(agent.HasApproverPolicy ? Localizer["Agents.ApproverPolicy.Present"] : Localizer["Agents.ApproverPolicy.Absent"])</p>
                    @if (agent.HasApproverPolicy)
                    {
                        <p>@Localizer["Agents.ApproverPolicy.Version", agent.ApproverPolicyVersion]</p>
                        <p>@Localizer["Agents.ApproverPolicy.Disclosure.Label"]: @Localizer[$"Agents.ApproverPolicy.Disclosure.{agent.ApproverPolicyDisclosure}"]</p>
                    }
                    <FluentAnchorButton Href="/agents/approver-policy" Appearance="ButtonAppearance.Subtle" data-testid="agents-config-approver-link">
                        @Localizer["Agents.Config.ApproverPolicy.Link"]
                    </FluentAnchorButton>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Lifecycle"]" @bind-Expanded="_expandedSections[7]">
                    <AgentReadinessBadge State="@AgentReadiness.MapState(agent)" />
                    <p data-testid="agents-config-lifecycle">@Localizer[$"Agents.Lifecycle.{agent.Lifecycle}"]</p>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.Blockers"]" @bind-Expanded="_expandedSections[8]">
                    @if (agent.ActivationBlockers.Count == 0)
                    {
                        <p data-testid="agents-config-blockers-none">@Localizer["Agents.Overview.Blockers.None"]</p>
                    }
                    else
                    {
                        <ul data-testid="agents-config-blockers">
                            @foreach (AgentActivationBlocker blocker in agent.ActivationBlockers)
                            {
                                <li data-testid="@($"agents-config-blocker-{blocker}")">@Localizer[AgentReadiness.BlockerKeyFor(blocker)]</li>
                            }
                        </ul>
                    }
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Agents.Config.Section.ContentSafety"]" @bind-Expanded="_expandedSections[9]">
                    <ul>
                        <li data-testid="agents-config-content-safety-presence">@(agent.HasContentSafetyPolicy ? Localizer["Agents.Config.ContentSafety.Present"] : Localizer["Agents.Config.ContentSafety.Absent"])</li>
                        @if (agent.HasContentSafetyPolicy)
                        {
                            <li data-testid="agents-config-content-safety-version">@Localizer["Agents.Config.ContentSafety.Version", agent.ContentSafetyPolicyVersion]</li>
                        }
                        @if (agent.HasAutomaticContentSafetyOverride)
                        {
                            <li>@Localizer["Agents.Config.ContentSafety.AutomaticOverride"]</li>
                        }
                        @if (agent.HasConfirmationContentSafetyOverride)
                        {
                            <li>@Localizer["Agents.Config.ContentSafety.ConfirmationOverride"]</li>
                        }
                    </ul>
                </FluentAccordionItem>

            </FluentAccordion>

            <section class="agents-config__activation" aria-label="@Localizer["Agents.Config.Activation.Label"]">
                @* Activation is a distinct action shown after validity is visible. Activating sets a lifecycle
                   flag; it never means the Agent can be called, and the note says so on every render. *@
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt || setup.ConfigurationVersion <= 0 || agent.Lifecycle == AgentLifecycleStatus.Active)"
                              OnClick="ActivateAsync"
                              data-testid="agents-config-activate">
                    @Localizer["Agents.Config.Activation.Label"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@(_busy || HasUnresolvedAttempt || !CanStartAttempt || agent.Lifecycle == AgentLifecycleStatus.Disabled)"
                              OnClick="DisableAsync"
                              data-testid="agents-config-disable">
                    @Localizer["Agents.Config.Disable.Label"]
                </FluentButton>
                <p class="agents-config__activation-note" data-testid="agents-config-activation-note">
                    @Localizer["Agents.Config.Activation.NotCallable"]
                </p>
            </section>
        }
        }
    </FluentStack>
</FcPageLayout>

@code {
    private const string HeadingId = "agents-config-heading";
    private static readonly TimeSpan ProjectionPollingInterval = TimeSpan.FromMilliseconds(250);
    private static readonly TimeSpan ProjectionPollingTimeout = TimeSpan.FromSeconds(8);

    private readonly bool[] _expandedSections = Enumerable.Repeat(true, 10).ToArray();
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private FcPageHeader? _header;
    private AgentSetupResult? _result;
    private AgentSetupWriteResult? _pendingWrite;
    private string? _writeAnnouncementKey;
    private AgentSetupAttempt? _activeAttempt;
    private AgentSetupScope? _scope;
    private AgentSetupEditableValues? _draftBaseline;
    private int _latestConfigurationVersion;
    private bool _draftReadRecovery;
    private bool _authenticationPending;
    private int _authenticationNotification;
    private AgentResponseMode _responseMode = AgentResponseMode.Unknown;
    private string _displayNameDraft = string.Empty;
    private string _descriptionDraft = string.Empty;
    private string _instructionsDraft = string.Empty;
    private bool _focusHeadingPending = true;
    private bool _busy;
    private bool _disposed;

    private bool HasUnresolvedAttempt => _activeAttempt is not null;

    private AgentSetupEditableValues CurrentDraft => new(_displayNameDraft, _descriptionDraft, _responseMode);

    private bool HasDivergentDraft => _draftBaseline is { } baseline
        && _result is { Status: AgentInspectionStatus.Success, Setup.TruthState: AgentSetupTruthState.ProjectionConfirmed }
        && AgentSetupEditableValues.From(_result.Setup.Agent).DivergesFrom(baseline, CurrentDraft);

    private bool CanStartAttempt => _scope is { } scope && AttemptStore.IsCurrent(scope)
        && _result?.Setup?.Agent.AgentId == scope.AgentId
        && _result.Setup.Agent.TenantId == scope.TenantId
        && Gateway is not DeferredAgentSetupGateway
        && _result is { Status: AgentInspectionStatus.Success, Setup.TruthState: AgentSetupTruthState.ProjectionConfirmed };

    protected override async Task OnInitializedAsync()
    {
        Authentication.AuthenticationStateChanged += OnAuthenticationChanged;
        _busy = true;
        try
        {
            CancellationToken cancellationToken = _lifetimeCancellation.Token;
            _scope = await AttemptStore.GetScopeAsync().WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            RetainedAgentSetupAttempt? retained = AttemptStore.Load(_scope);
            if (retained is not null)
            {
                _activeAttempt = retained.Attempt;
                _pendingWrite = retained.PendingWrite?.Acceptance is { } acceptance
                    ? AgentSetupWriteResult.AwaitingProjection(acceptance)
                    : retained.PendingWrite ?? AgentSetupWriteResult.Failed(AgentSetupWriteStatus.UnableToVerify);
                ApplyDraft(retained.Draft);
                _instructionsDraft = retained.InstructionsDraft;
                _draftBaseline = retained.Baseline;
            }

            // Returning to this route performs one authorized read, never an automatic submission.
            await LoadAsync(_pendingWrite?.TargetConfigurationVersion, cancellationToken,
                applyAuthoritativeDrafts: retained is null);
            if (retained?.PendingWrite?.Acceptance is not null && IsAcceptedProjectionConfirmed())
            {
                _pendingWrite = null;
                _writeAnnouncementKey = "Agents.Config.Write.Confirmed";
                ReleaseAttempt(restoreInstructionsDraft: false);
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Component disposal owns this cancellation. No post-navigation state or render is produced.
        }
        catch (Exception)
        {
            if (!_disposed)
            {
                _result = AgentSetupResult.Unavailable();
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busy = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHeadingPending && _header is not null)
        {
            _focusHeadingPending = false;
            await _header.FocusHeadingAsync();
        }
    }

    // Selecting a mode only stages the choice; nothing changes until the administrator submits it, and even then
    // the rendered state comes from the re-read rather than from the selection (never optimistic).
    private void OnResponseModeChanged(AgentResponseMode mode) => _responseMode = mode;

    private async Task SubmitConfigurationAsync()
    {
        // Instructions are required by the command and are never read back into the page, so the draft is the
        // whole text the administrator intends to store.
        if (string.IsNullOrWhiteSpace(_instructionsDraft))
        {
            return;
        }

        UpdateAgentConfiguration command = new(
            _displayNameDraft,
            string.IsNullOrWhiteSpace(_descriptionDraft) ? null : _descriptionDraft,
            _instructionsDraft);
        await SubmitAsync(AgentSetupAttemptKind.Configuration, configuration: command);
    }

    private Task SubmitResponseModeAsync()
        => SubmitAsync(AgentSetupAttemptKind.ResponseMode, responseMode: _responseMode);

    private Task ActivateAsync()
        => _result?.Setup?.ConfigurationVersion is > 0 and int version
            ? SubmitAsync(AgentSetupAttemptKind.Activate, expectedConfigurationVersion: version)
            : Task.CompletedTask;

    private Task DisableAsync() => SubmitAsync(AgentSetupAttemptKind.Disable);

    private Task SubmitAsync(
        AgentSetupAttemptKind kind,
        UpdateAgentConfiguration? configuration = null,
        AgentResponseMode responseMode = AgentResponseMode.Unknown,
        int? expectedConfigurationVersion = null)
    {
        if (_busy || _activeAttempt is not null || !CanStartAttempt)
        {
            return Task.CompletedTask;
        }

        var options = new AgentOperationOptions(
            CorrelationId: UlidFactory.NewUlid(),
            IdempotencyKey: UlidFactory.NewUlid())
        {
            ExpectedConfigurationVersion = expectedConfigurationVersion,
        };
        var attempt = new AgentSetupAttempt(options, kind, configuration, responseMode);
        var retained = new RetainedAgentSetupAttempt(attempt, null, CurrentDraft,
            configuration is not null ? string.Empty : _instructionsDraft, _draftBaseline);
        if (!AttemptStore.TryBegin(_scope, retained))
        {
            return Task.CompletedTask;
        }

        _pendingWrite = null;
        _writeAnnouncementKey = null;
        _activeAttempt = attempt;
        if (configuration is not null)
        {
            _instructionsDraft = string.Empty;
        }

        return ExecuteAttemptAsync(attempt);
    }

    private async Task ExecuteAttemptAsync(AgentSetupAttempt attempt)
    {
        if (!EnsureCurrentScope())
        {
            return;
        }

        _busy = true;
        try
        {
            CancellationToken cancellationToken = _lifetimeCancellation.Token;

            AgentCommandAcceptance? retainedAcceptance = _pendingWrite?.Acceptance;
            AgentSetupWriteResult writeResult = await attempt.SubmitAsync(Gateway, cancellationToken)
                .WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (!await ConfirmCurrentScopeAsync(cancellationToken))
            {
                return;
            }

            if (retainedAcceptance is not null
                && (writeResult.Status != AgentSetupWriteStatus.Submitted || writeResult.Acceptance != retainedAcceptance)
                && writeResult.Status != AgentSetupWriteStatus.NotAuthorized
                && writeResult.Status != AgentSetupWriteStatus.NotFound)
            {
                // Once EventStore has accepted an attempt, a later retry response cannot erase that evidence.
                // In particular, an AlreadyApplied replay is not a new no-op: the original eventful receipt still
                // needs its target projection confirmed before this attempt can be released. This only holds for
                // replay-consistency outcomes and a changed receipt (including a later rejection):
                // NotAuthorized and NotFound are decided by the authorization/dispatch check before the idempotency
                // key is even considered, so a fresh denial there is new, trustworthy evidence — not a replay
                // artifact — and must surface immediately instead of masking it as still-pending.
                _pendingWrite = AgentSetupWriteResult.AwaitingProjection(retainedAcceptance);
                _writeAnnouncementKey = "Agents.Config.Write.RetryUnresolved";
                return;
            }

            _pendingWrite = writeResult;
            _writeAnnouncementKey = null;
            if (writeResult.Status == AgentSetupWriteStatus.AlreadyApplied)
            {
                ReleaseAttempt(restoreInstructionsDraft: false);
            }
            else if (writeResult.Status == AgentSetupWriteStatus.Submitted
                && writeResult.Acceptance is { } acceptance
                && writeResult.TargetConfigurationVersion is int targetVersion)
            {
                SaveRetainedAttempt();
                await RequestRenderAsync(cancellationToken);
                AgentSetupTruthState refreshState = await RefreshAfterWriteAsync(
                        targetVersion,
                        cancellationToken);

                if (!EnsureCurrentScope())
                {
                    return;
                }

                if (refreshState == AgentSetupTruthState.ProjectionConfirmed && IsAcceptedProjectionConfirmed())
                {
                    cancellationToken.ThrowIfCancellationRequested();
                    _pendingWrite = null;
                    _writeAnnouncementKey = "Agents.Config.Write.Confirmed";
                    ReleaseAttempt(restoreInstructionsDraft: false);
                }
                else
                {
                    _pendingWrite = AgentSetupWriteResult.AwaitingProjection(acceptance);
                }
            }
            else if (writeResult.Status == AgentSetupWriteStatus.Submitted)
            {
                _pendingWrite = AgentSetupWriteResult.Failed(AgentSetupWriteStatus.UnableToVerify);
            }
            else if (IsTerminalWriteFailure(writeResult.Status))
            {
                ReleaseAttempt(restoreInstructionsDraft: true);
                if (writeResult.Status == AgentSetupWriteStatus.Rejected)
                {
                    await RefreshAfterRejectionAsync(cancellationToken);
                }
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Navigation stops local observation; it does not cancel a command already submitted to the server.
        }
        catch (Exception)
        {
            // A gateway that throws is a failed write, not a silent one: report the fail-closed status instead of
            // leaving the page on its pre-write state with no outcome (AD-12), and never surface the raw error.
            if (!_disposed && EnsureCurrentScope())
            {
                _pendingWrite = RetainedAwaitingProjection()
                    ?? AgentSetupWriteResult.Failed(AgentSetupWriteStatus.Unavailable);

                // A stale announcement from an earlier retry cycle (e.g. RetryUnresolved) must not outlive this
                // attempt's own outcome: without this reset the live region would keep announcing the prior
                // cycle's message instead of the fail-closed status just recomputed above.
                _writeAnnouncementKey = null;
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busy = false;
                SaveRetainedAttempt();
            }
        }
    }

    private async Task RefreshAfterRejectionAsync(CancellationToken cancellationToken)
    {
        // A rejected activation may name an outdated version. Invalidate it before reading current setup,
        // preserving the rejection and all drafts even if the refresh cannot establish new authority.
        _result = AgentSetupResult.Unavailable();
        try
        {
            await LoadAsync(null, cancellationToken, applyAuthoritativeDrafts: false);
        }
        catch (Exception)
        {
            cancellationToken.ThrowIfCancellationRequested();
            _result = AgentSetupResult.Unavailable();
        }
    }

    private Task RetryAttemptAsync()
        => _activeAttempt is { } attempt && !_busy
            ? ExecuteAttemptAsync(attempt)
            : Task.CompletedTask;

    private async Task RefreshPendingAsync()
    {
        if (_busy
            || !EnsureCurrentScope()
            || _activeAttempt is null
            || _pendingWrite?.Acceptance is not { } acceptance
            || _pendingWrite.TargetConfigurationVersion is not int targetVersion)
        {
            return;
        }

        _busy = true;
        try
        {
            CancellationToken cancellationToken = _lifetimeCancellation.Token;
            _writeAnnouncementKey = "Agents.Config.Write.Refreshing";
            await RequestRenderAsync(cancellationToken);
            await LoadAsync(targetVersion, cancellationToken, applyAuthoritativeDrafts: false);
            if (!EnsureCurrentScope())
            {
                return;
            }
            AgentSetupTruthState refreshState = _result?.Setup?.TruthState ?? AgentSetupTruthState.Unknown;
            if (refreshState == AgentSetupTruthState.ProjectionConfirmed && IsAcceptedProjectionConfirmed())
            {
                cancellationToken.ThrowIfCancellationRequested();
                _pendingWrite = null;
                _writeAnnouncementKey = "Agents.Config.Write.Confirmed";
                ReleaseAttempt(restoreInstructionsDraft: false);
            }
            else
            {
                _pendingWrite = AgentSetupWriteResult.AwaitingProjection(acceptance);
                _writeAnnouncementKey = "Agents.Config.Write.RefreshIncomplete";
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Component disposal owns this cancellation.
        }
        catch (Exception)
        {
            if (!_disposed && EnsureCurrentScope())
            {
                _pendingWrite = RetainedAwaitingProjection()
                    ?? AgentSetupWriteResult.Failed(AgentSetupWriteStatus.Unavailable);
                _writeAnnouncementKey = _pendingWrite?.Acceptance is not null
                    ? "Agents.Config.Write.RefreshIncomplete"
                    : null;
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busy = false;
                SaveRetainedAttempt();
            }
        }
    }

    // A read that throws says nothing about the write that was already accepted. Collapsing to Unavailable would
    // relabel that accepted write as a service outage and, because the Refresh action is gated on a known target
    // version, would also strip the one read-only recovery the retained attempt still has. Keeping the acceptance
    // leaves the attempt exactly where it was: awaiting projection, with Refresh, Retry and Abandon available.
    private AgentSetupWriteResult? RetainedAwaitingProjection()
        => _pendingWrite is { Acceptance: { } acceptance, TargetConfigurationVersion: not null }
            ? AgentSetupWriteResult.AwaitingProjection(acceptance)
            : null;

    private void AbandonAttempt()
    {
        if (_busy || !EnsureCurrentScope())
        {
            return;
        }

        ReleaseAttempt(restoreInstructionsDraft: true);
        _pendingWrite = null;
        _writeAnnouncementKey = "Agents.Config.Write.Abandoned";
    }

    private void ReleaseAttempt(bool restoreInstructionsDraft)
    {
        AgentSetupAttempt? attempt = _activeAttempt;
        AttemptStore.Release(_scope, attempt);
        _activeAttempt = null;
        if (restoreInstructionsDraft
            && attempt?.Configuration?.Instructions is { } draft
            && string.IsNullOrEmpty(_instructionsDraft))
        {
            _instructionsDraft = draft;
        }
    }

    private static bool IsTerminalWriteFailure(AgentSetupWriteStatus status)
        => status is AgentSetupWriteStatus.NotAuthorized
            or AgentSetupWriteStatus.NotFound
            or AgentSetupWriteStatus.ValidationFailed
            or AgentSetupWriteStatus.Conflict
            or AgentSetupWriteStatus.Rejected;

    private async Task<AgentSetupTruthState> RefreshAfterWriteAsync(
        int? expectedConfigurationVersion,
        CancellationToken cancellationToken)
    {
        using CancellationTokenSource timeoutCancellation = new(ProjectionPollingTimeout, TimeProvider);
        using CancellationTokenSource pollingCancellation = CancellationTokenSource.CreateLinkedTokenSource(
            cancellationToken,
            timeoutCancellation.Token);

        try
        {
            await LoadAsync(
                expectedConfigurationVersion,
                pollingCancellation.Token,
                applyAuthoritativeDrafts: false);
            if (_result?.Setup is not { TruthState: AgentSetupTruthState.AuthoritativePending })
            {
                return _result?.Setup?.TruthState ?? AgentSetupTruthState.Unknown;
            }

            await RequestRenderAsync(pollingCancellation.Token);
            while (_result?.Setup is { TruthState: AgentSetupTruthState.AuthoritativePending })
            {
                await Task.Delay(ProjectionPollingInterval, TimeProvider, pollingCancellation.Token);
                await LoadAsync(
                    expectedConfigurationVersion,
                    pollingCancellation.Token,
                    applyAuthoritativeDrafts: false);
            }

            return _result?.Setup?.TruthState ?? AgentSetupTruthState.Unknown;
        }
        catch (OperationCanceledException) when (
            timeoutCancellation.IsCancellationRequested && !cancellationToken.IsCancellationRequested)
        {
            // Exhaustion preserves the last authoritative-pending view; callers relabel the retained acceptance
            // as AwaitingProjection and keep its recovery actions available.
            return AgentSetupTruthState.AuthoritativePending;
        }
    }

    private async Task LoadAsync(
        int? expectedConfigurationVersion,
        CancellationToken cancellationToken,
        bool applyAuthoritativeDrafts)
    {
        if (_disposed || !await ConfirmCurrentScopeAsync(cancellationToken))
        {
            return;
        }

        AgentSetupResult result;
        try
        {
            result = await Gateway.GetSetupAsync(expectedConfigurationVersion, cancellationToken)
                .WaitAsync(cancellationToken);
        }
        catch (Exception) when (!cancellationToken.IsCancellationRequested)
        {
            // The pending command receipt is independent from the setup read; disclose no stale setup on failure.
            if (!_disposed && EnsureCurrentScope())
            {
                _result = AgentSetupResult.Unavailable();
            }
            throw;
        }

        cancellationToken.ThrowIfCancellationRequested();
        if (!await ConfirmCurrentScopeAsync(cancellationToken))
        {
            return;
        }

        // A malformed result must not disclose a setup carried alongside a failure status.
        _result = result.Status == AgentInspectionStatus.Success ? result : result with { Setup = null };
        if (_result.Setup is { } scopedSetup
            && (scopedSetup.Agent.AgentId != _scope!.AgentId || scopedSetup.Agent.TenantId != _scope.TenantId))
        {
            _result = AgentSetupResult.Unavailable();
        }

        if (_result is { Status: AgentInspectionStatus.Success,
            Setup.TruthState: AgentSetupTruthState.AuthoritativePending or AgentSetupTruthState.ProjectionConfirmed })
        {
            AgentSetupEditableValues saved = AgentSetupEditableValues.From(_result.Setup.Agent);
            if (applyAuthoritativeDrafts)
            {
                _draftBaseline = saved;
                ApplyDraft(saved);
            }
            else if (_result.Setup.TruthState == AgentSetupTruthState.ProjectionConfirmed
                && _result.Setup.ConfigurationVersion >= _latestConfigurationVersion && _draftBaseline is not null)
            {
                _draftBaseline = _draftBaseline.AdvanceConfirmedFields(saved, CurrentDraft);
            }

            _latestConfigurationVersion = Math.Max(_latestConfigurationVersion, _result.Setup.ConfigurationVersion);
        }
    }

    private Task LoadSavedValuesAsync() => RefreshValuesAsync(replaceDraft: true);

    private Task RefreshAuthorityAsync() => RefreshValuesAsync(replaceDraft: false);

    private async Task RefreshValuesAsync(bool replaceDraft)
    {
        if (_busy || HasUnresolvedAttempt || !EnsureCurrentScope())
        {
            return;
        }

        _busy = true;
        _draftReadRecovery = true;
        int minimumVersion = _latestConfigurationVersion;
        try
        {
            // An explicit replacement cannot roll back a version already observed on this page. A failed read
            // leaves a separate read-only refresh available so the editor can be recovered without losing drafts.
            await LoadAsync(minimumVersion > 0 ? minimumVersion : null, _lifetimeCancellation.Token,
                applyAuthoritativeDrafts: false);
            if (!EnsureCurrentScope())
            {
                return;
            }

            if (_result is { Status: AgentInspectionStatus.Success, Setup.TruthState: AgentSetupTruthState.ProjectionConfirmed })
            {
                if (_result.Setup.ConfigurationVersion < minimumVersion)
                {
                    _result = AgentSetupResult.Unavailable();
                    return;
                }

                _draftReadRecovery = false;
                if (replaceDraft)
                {
                    _draftBaseline = AgentSetupEditableValues.From(_result.Setup.Agent);
                    ApplyDraft(_draftBaseline);
                }
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Local observation ended on navigation.
        }
        catch (Exception)
        {
            if (!_disposed && EnsureCurrentScope())
            {
                _result = AgentSetupResult.Unavailable();
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busy = false;
            }
        }
    }

    private void ApplyDraft(AgentSetupEditableValues values)
    {
        _displayNameDraft = values.DisplayName;
        _descriptionDraft = values.Description;
        _responseMode = values.ResponseMode;
    }

    private bool IsAcceptedProjectionConfirmed()
        => _pendingWrite?.TargetConfigurationVersion is int target
            && _result is { Status: AgentInspectionStatus.Success,
                Setup.TruthState: AgentSetupTruthState.ProjectionConfirmed }
            && _result.Setup.ConfigurationVersion >= target;

    private void SaveRetainedAttempt()
    {
        if (_activeAttempt is { } attempt)
        {
            AttemptStore.Save(_scope, new(attempt, _pendingWrite, CurrentDraft, _instructionsDraft, _draftBaseline));
        }
    }

    private bool EnsureCurrentScope()
    {
        if (AttemptStore.IsCurrent(_scope))
        {
            return true;
        }

        if (!_authenticationPending)
        {
            ClearScopePresentation();
        }
        return false;
    }

    private async Task<bool> ConfirmCurrentScopeAsync(CancellationToken cancellationToken)
    {
        AgentSetupScope? current = await AttemptStore.GetScopeAsync().WaitAsync(cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        if (_scope is not null && ReferenceEquals(_scope, current) && AttemptStore.IsCurrent(_scope))
        {
            return true;
        }

        ClearScopePresentation();
        return false;
    }

    private void ClearScopePresentation()
    {
        _activeAttempt = null;
        _pendingWrite = null;
        _writeAnnouncementKey = null;
        _draftBaseline = null;
        _latestConfigurationVersion = 0;
        _draftReadRecovery = false;
        _displayNameDraft = _descriptionDraft = _instructionsDraft = string.Empty;
        _responseMode = AgentResponseMode.Unknown;
        _result = AgentSetupResult.NotAuthorized();
    }

    private void OnAuthenticationChanged(Task<AuthenticationState> state)
        => _ = InvokeAsync(() => ObserveAuthenticationChangeAsync(state));

    private async Task ObserveAuthenticationChangeAsync(Task<AuthenticationState> state)
    {
        if (_disposed)
        {
            return;
        }

        int notification = ++_authenticationNotification;
        if (AttemptStore.IsCurrent(_scope))
        {
            _authenticationPending = false;
            StateHasChanged();
            return;
        }

        // Hide the whole previous-user surface immediately, but do not discard its drafts while an unchanged
        // binding is still possible. The store also blocks every operation during this interval.
        _authenticationPending = true;
        StateHasChanged();
        CancellationToken cancellationToken = _lifetimeCancellation.Token;
        try
        {
            try
            {
                await state.WaitAsync(cancellationToken);
            }
            catch (Exception) when (!cancellationToken.IsCancellationRequested)
            {
                // The store turns a faulted authentication result into an invalid binding.
            }

            AgentSetupScope? current = await AttemptStore.GetScopeAsync().WaitAsync(cancellationToken);
            if (_disposed || notification != _authenticationNotification)
            {
                return;
            }

            _authenticationPending = false;
            if (_scope is null || !ReferenceEquals(_scope, current) || !AttemptStore.IsCurrent(_scope))
            {
                ClearScopePresentation();
            }
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Disposal ends observation without retaining the page until the authentication task completes.
        }
    }

    private Task RequestRenderAsync(CancellationToken cancellationToken)
        => InvokeAsync(() =>
        {
            cancellationToken.ThrowIfCancellationRequested();
            StateHasChanged();
        });

    /// <inheritdoc />
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        SaveRetainedAttempt();
        Authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
        _disposed = true;
        _lifetimeCancellation.Cancel();
        _lifetimeCancellation.Dispose();
    }
}
