@page "/agents/providers"
@attribute [Authorize(Policy = AgentsFrontComposerRegistration.PlatformOperatorPolicy)]
@implements IDisposable
@inject IStringLocalizer<AgentsResources> Localizer
@inject IProviderCatalogGateway Gateway
@inject TimeProvider TimeProvider
@inject IPendingProviderCommandStore PendingCommands

@using Hexalith.Agents.Contracts.ProviderCatalog.Commands

@* Provider catalog (Story 5.3): a full-width FluentDataGrid surface showing safe capability, pricing,
   enablement, configured-state, CapabilityVersion, and freshness — never secret values, the configuration
   reference id, raw provider payloads, or SDK details. Writes follow submitted → pending → confirmed. *@
<FcContentLabel LabelledBy="@HeadingId" />
<FcAggregateListPage @ref="_listPage"
                     TItem="ProviderCatalogEntryView"
                     LayoutMode="FcPageLayoutMode.FullWidth"
                     RootTestId="agents-provider-catalog"
                     RootClass="agents-provider-catalog"
                     PageTitle="@Localizer["Agents.ProviderCatalog.Title"]"
                     Heading="@Localizer["Agents.ProviderCatalog.Title"]"
                     HeadingId="@HeadingId"
                     HeadingTabIndex="-1"
                     Eyebrow="@Localizer["Agents.ProviderCatalog.Eyebrow"]"
                     Description="@Localizer["Agents.ProviderCatalog.Description"]"
                     HeaderTestId="agents-provider-catalog-header">
    <Filters>
        <section aria-label="@Localizer["Agents.ProviderCatalog.ControlsLabel"]">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px">
                <FluentSwitch @bind-Value="_selectableOnly"
                              Label="@Localizer["Agents.ProviderCatalog.Filter.SelectableOnly"]"
                              data-testid="agents-provider-catalog-selectable-filter" />
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Disabled="_busy || _pendingRestoring || _storeUnavailable"
                              OnClick="BeginCreate"
                              data-testid="agents-provider-catalog-create">
                    @Localizer["Agents.ProviderCatalog.Action.Create"]
                </FluentButton>
            </FluentStack>
        </section>
        @if (_pendingWrite is { Status: AgentSetupWriteStatus.Submitted })
        {
            <p data-testid="agents-provider-catalog-truth" aria-live="polite">
                @Localizer[$"Agents.ProviderCatalog.Truth.Stage.{DisplayedWriteTruth}"]
            </p>
        }
        else if (_pendingWrite is { } failedWrite)
        {
            <p data-testid="agents-provider-catalog-truth" aria-live="polite">
                @Localizer[$"Agents.ProviderCatalog.Write.Status.{failedWrite.Status}"]
            </p>
        }
        else if (_result is { TruthState: not AgentSetupTruthState.Unknown })
        {
            <p data-testid="agents-provider-catalog-freshness" aria-live="polite">
                @Localizer[$"Agents.ProviderCatalog.Freshness.{_result.Freshness}"]
            </p>
        }
        @foreach (var pending in _pendingCatalogCommands)
        {
            <FluentButton Disabled="_busy" OnClick="@(() => CheckPendingCatalogAsync(pending.Key))"
                          data-testid="agents-provider-catalog-check-pending">
                @Localizer["Agents.ProviderCatalog.Action.CheckPending", pending.Value.Acceptance.ProviderId, pending.Value.Acceptance.ModelId]
            </FluentButton>
        }
        @if (_editorOpen)
        {
            <FluentAccordion>
                <FluentAccordionItem Heading="@Localizer["Agents.ProviderCatalog.Editor.Title"]" Expanded="true">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" data-testid="agents-provider-catalog-editor">
                        <FluentTextInput @bind-Value="_providerId"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.Provider"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.Provider"]"
                                         Disabled="_editing"
                                         data-testid="agents-provider-catalog-provider-input" />
                        <FluentTextInput @bind-Value="_modelId"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.Model"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.Model"]"
                                         Disabled="_editing"
                                         data-testid="agents-provider-catalog-model-input" />
                        <FluentTextInput @bind-Value="_displayLabel"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.Label"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.Label"]"
                                         data-testid="agents-provider-catalog-label-input" />
                        <FluentTextInput @bind-Value="_currency"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.Currency"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.Currency"]"
                                         data-testid="agents-provider-catalog-currency-input" />
                        <FluentTextInput @bind-Value="_inputPrice"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.InputPrice"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.InputPrice"]"
                                         data-testid="agents-provider-catalog-input-price-input" />
                        <FluentTextInput @bind-Value="_outputPrice"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.OutputPrice"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.OutputPrice"]"
                                         data-testid="agents-provider-catalog-output-price-input" />
                        <FluentTextInput @bind-Value="_contextWindow"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.ContextWindow"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.ContextWindow"]"
                                         data-testid="agents-provider-catalog-context-window-input" />
                        <FluentTextInput @bind-Value="_maxOutput"
                                         Label="@Localizer["Agents.ProviderCatalog.Column.MaxOutput"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Column.MaxOutput"]"
                                         data-testid="agents-provider-catalog-max-output-input" />
                        <FluentTextInput @bind-Value="_timeoutMs"
                                         Label="@Localizer["Agents.ProviderCatalog.Editor.TimeoutMilliseconds"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Editor.TimeoutMilliseconds"]"
                                         data-testid="agents-provider-catalog-timeout-input" />
                        <FluentTextInput @bind-Value="_maxRetries"
                                         Label="@Localizer["Agents.ProviderCatalog.Editor.MaxRetries"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Editor.MaxRetries"]"
                                         data-testid="agents-provider-catalog-retries-input" />
                        <FluentSwitch @bind-Value="_supportsTextGeneration"
                                      Label="@Localizer["Agents.ProviderCatalog.Capability.TextGeneration"]"
                                      data-testid="agents-provider-catalog-text-generation-input" />
                        @if (!_editing)
                        {
                            <FluentSwitch @bind-Value="_createEnabled"
                                          Label="@Localizer["Agents.ProviderCatalog.ModelStatus.Enabled"]"
                                          data-testid="agents-provider-catalog-create-enabled-input" />
                        }
                        <FluentSwitch @bind-Value="_supportsStreaming"
                                      Label="@Localizer["Agents.ProviderCatalog.Capability.Streaming"]"
                                      data-testid="agents-provider-catalog-streaming-input" />
                        <FluentSwitch @bind-Value="_supportsToolCalling"
                                      Label="@Localizer["Agents.ProviderCatalog.Capability.ToolCalling"]"
                                      data-testid="agents-provider-catalog-tool-calling-input" />
                        <FluentSwitch @bind-Value="_supportsVision"
                                      Label="@Localizer["Agents.ProviderCatalog.Capability.Vision"]"
                                      data-testid="agents-provider-catalog-vision-input" />
                        <FluentSwitch @bind-Value="_supportsStructuredOutput"
                                      Label="@Localizer["Agents.ProviderCatalog.Capability.StructuredOutput"]"
                                      data-testid="agents-provider-catalog-structured-output-input" />
                        <FluentTextInput @bind-Value="_configurationReference"
                                         Label="@Localizer["Agents.ProviderCatalog.Editor.ConfigurationReference"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Editor.ConfigurationReference"]"
                                         autocomplete="off"
                                         Disabled="_clearConfigurationReference"
                                         data-testid="agents-provider-catalog-configuration-reference-input" />
                        @if (_editing)
                        {
                            <FluentSwitch @bind-Value="_clearConfigurationReference"
                                          Label="@Localizer["Agents.ProviderCatalog.Editor.ClearConfigurationReference"]"
                                          data-testid="agents-provider-catalog-clear-configuration-reference" />
                        }
                        <FluentTextInput @bind-Value="_retentionDays"
                                         Label="@Localizer["Agents.ProviderCatalog.DataHandling.RetentionDays"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.DataHandling.RetentionDays"]"
                                         data-testid="agents-provider-catalog-retention-input" />
                        <FluentSwitch @bind-Value="_trainingUse"
                                      Label="@Localizer["Agents.ProviderCatalog.DataHandling.TrainingUse"]"
                                      role="switch"
                                      data-testid="agents-provider-catalog-training-input" />
                        <FluentTextInput @bind-Value="_processingRegions"
                                         Label="@Localizer["Agents.ProviderCatalog.DataHandling.ProcessingRegions"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.DataHandling.ProcessingRegions"]"
                                         data-testid="agents-provider-catalog-regions-input" />
                        <FluentTextInput @bind-Value="_termsReference"
                                         Label="@Localizer["Agents.ProviderCatalog.DataHandling.TermsReference"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.DataHandling.TermsReference"]"
                                         data-testid="agents-provider-catalog-terms-input" />
                        @if (_editing)
                        {
                            <FluentSwitch @bind-Value="_declareTightening"
                                          Label="@Localizer["Agents.ProviderCatalog.DataHandling.DeclareTightening"]"
                                          data-testid="agents-provider-catalog-declare-tightening" />
                        }
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                            <FluentButton Appearance="ButtonAppearance.Primary"
                                          Disabled="_busy || _pendingRestoring || _storeUnavailable || IsPending(_providerId, _modelId)"
                                          OnClick="SubmitEditorAsync"
                                          data-testid="agents-provider-catalog-save">
                                @Localizer["Agents.ProviderCatalog.Action.Save"]
                            </FluentButton>
                            <FluentButton Disabled="_busy" OnClick="CancelEditor" data-testid="agents-provider-catalog-cancel">
                                @Localizer["Agents.ProviderCatalog.Action.Cancel"]
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </FluentAccordionItem>
            </FluentAccordion>
        }
        @if (_enablementEntry is { } selected)
        {
            <FluentAccordion>
                <FluentAccordionItem Heading="@Localizer["Agents.ProviderCatalog.Enablement.Title"]" Expanded="true">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" data-testid="agents-provider-catalog-enablement-editor">
                        <FluentText>@selected.ProviderId / @selected.ModelId</FluentText>
                        <FluentTextInput @bind-Value="_enablementTenantId" @bind-Value:after="OnEnablementTenantChanged"
                                         Label="@Localizer["Agents.ProviderCatalog.Enablement.Tenant"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Enablement.Tenant"]"
                                         data-testid="agents-provider-catalog-enablement-tenant" />
                        <FluentButton Disabled="_busy" OnClick="LoadEnablementRevisionAsync"
                                      data-testid="agents-provider-catalog-enablement-load">
                            @Localizer["Agents.ProviderCatalog.Enablement.Load"]
                        </FluentButton>
                        <FluentTextInput @bind-Value="_enablementExpectedRevision"
                                         Label="@Localizer["Agents.ProviderCatalog.Enablement.ExpectedRevision"]"
                                         AriaLabel="@Localizer["Agents.ProviderCatalog.Enablement.ExpectedRevision"]"
                                         data-testid="agents-provider-catalog-enablement-revision" />
                        <FluentSwitch @bind-Value="_enablementEnabled"
                                      Label="@Localizer["Agents.ProviderCatalog.Enablement.Enabled"]"
                                      data-testid="agents-provider-catalog-enablement-enabled" />
                        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="_busy || _pendingRestoring || _storeUnavailable || PendingSelectedEnablement || _enablementTruth == nameof(AgentSetupTruthState.AuthoritativePending)"
                                      OnClick="SubmitEnablementAsync" data-testid="agents-provider-catalog-enablement-save">
                            @Localizer["Agents.ProviderCatalog.Action.Save"]
                        </FluentButton>
                        @if (PendingSelectedEnablement)
                        {
                            <FluentButton Disabled="_busy" OnClick="CheckPendingEnablementAsync"
                                          data-testid="agents-provider-catalog-enablement-check-pending">
                                @Localizer["Agents.TenantProviders.CheckPending"]
                            </FluentButton>
                        }
                        @if (_enablementWrite is { } outcome)
                        {
                            <FluentText aria-live="polite" data-testid="agents-provider-catalog-enablement-truth">
                                @(outcome.Status is AgentSetupWriteStatus.Submitted
                                    ? Localizer[$"Agents.ProviderCatalog.Truth.Stage.{_enablementTruth ?? "Submitted"}"]
                                    : Localizer[$"Agents.ProviderCatalog.Write.Status.{outcome.Status}"])
                            </FluentText>
                        }
                        else if (PendingSelectedEnablement || _enablementTruth is not null)
                        {
                            <FluentText aria-live="polite" data-testid="agents-provider-catalog-enablement-truth">
                                @Localizer[$"Agents.ProviderCatalog.Truth.Stage.{_enablementTruth ?? "AuthoritativePending"}"]
                            </FluentText>
                        }
                    </FluentStack>
                </FluentAccordionItem>
            </FluentAccordion>
        }
    </Filters>
    <States>
        @if (_result is null)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Loading" TestId="agents-provider-catalog-state" />
        }
        else if (_result.Status is ProviderCatalogInspectionStatus.NotAuthorized)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.PermissionDenied" TestId="agents-provider-catalog-state" />
        }
        else if (_result.Status is ProviderCatalogInspectionStatus.Unavailable)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Error" TestId="agents-provider-catalog-state" />
        }
        else if (_result is { TruthState: AgentSetupTruthState.AuthoritativePending, Entries.Count: 0 })
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Stale" TestId="agents-provider-catalog-state" />
        }
        else if (_result.Status is ProviderCatalogInspectionStatus.EntryNotFound || _result.Entries.Count == 0)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.Empty" TestId="agents-provider-catalog-state" />
        }
        else if (VisibleRows.Count == 0)
        {
            <AgentSurfaceState Kind="AgentSurfaceKind.FilteredEmpty" TestId="agents-provider-catalog-state" OnReset="ResetFilters" />
        }
    </States>
    <Body>
        @if (ShowGrid)
        {
            <FluentDataGrid Items="@VisibleRows.AsQueryable()"
                            ResizableColumns="true"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            ItemKey="@(entry => ProviderCatalogIdentity.EntryId(entry.ProviderId, entry.ModelId))"
                            data-testid="agents-provider-catalog-grid">
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Provider"]"
                                ColumnId="provider"
                                Width="200px"
                                Sortable="true"
                                SortBy="@_sortByProvider"
                                Pin="DataGridColumnPin.Start">
                    <code data-testid="agents-provider-catalog-provider">@context.ProviderId</code>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Model"]" ColumnId="model">
                    <code>@context.ModelId</code>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Label"]" ColumnId="label">
                    @context.DisplayLabel
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Status"]" ColumnId="status">
                    <ProviderStatusBadge State="@AgentReadiness.MapProviderState(context)" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Capabilities"]" ColumnId="capabilities">
                    <ul class="agents-provider-catalog__capabilities">
                        @foreach (string capability in CapabilityLabels(context))
                        {
                            <li>@capability</li>
                        }
                    </ul>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.ContextWindow"]" ColumnId="context-window">
                    @Localizer["Agents.ProviderCatalog.Tokens.Value", context.ContextWindowTokenLimit]
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.MaxOutput"]" ColumnId="max-output">
                    @Localizer["Agents.ProviderCatalog.Tokens.Value", context.MaxOutputTokenLimit]
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Timeout"]" ColumnId="timeout">
                    @Localizer["Agents.ProviderCatalog.Timeout.Value", context.TimeoutPolicy.RequestTimeoutMilliseconds, context.TimeoutPolicy.MaxRetries]
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Pricing"]" ColumnId="pricing">
                    <span data-testid="agents-provider-catalog-pricing">@PricingLabel(context)</span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.CapabilityVersion"]" ColumnId="capability-version">
                    <span data-testid="agents-provider-catalog-capability-version">@context.CapabilityVersion</span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.DataHandling.Version"]" ColumnId="data-handling-version">
                    @(context.DataHandling?.DataHandlingVersion.ToString(CultureInfo.InvariantCulture) ?? Localizer["Agents.ProviderCatalog.DataHandling.Missing"])
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Freshness"]" ColumnId="freshness">
                    @Localizer[$"Agents.ProviderCatalog.Freshness.{_result!.Freshness}"]
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Selectable"]" ColumnId="selectable">
                    @(context.IsSelectableForNewActiveUse
                        ? Localizer["Agents.ProviderCatalog.Selectable.Yes"]
                        : Localizer["Agents.ProviderCatalog.Selectable.No"])
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Configured"]" ColumnId="configured">
                    <span data-testid="agents-provider-catalog-configured">@Localizer[$"Agents.ProviderCatalog.ConfigurationState.{context.ConfigurationState}"]</span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Agents.ProviderCatalog.Column.Actions"]" ColumnId="actions">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                        <FluentButton Disabled="_busy || _pendingRestoring || _storeUnavailable || IsPending(context.ProviderId, context.ModelId)" OnClick="@(() => BeginEdit(context))" data-testid="agents-provider-catalog-edit">
                            @Localizer["Agents.ProviderCatalog.Action.Edit"]
                        </FluentButton>
                        <FluentButton Disabled="_busy" OnClick="@(() => BeginEnablement(context))"
                                      data-testid="agents-provider-catalog-set-tenant-enablement">
                            @Localizer["Agents.ProviderCatalog.Enablement.Title"]
                        </FluentButton>
                        @if (context.Status is ProviderModelStatus.Enabled)
                        {
                            <FluentButton Disabled="_busy || _pendingRestoring || _storeUnavailable || IsPending(context.ProviderId, context.ModelId)" OnClick="@(() => SubmitLifecycleAsync(context, enable: false))" data-testid="agents-provider-catalog-disable">
                                @Localizer["Agents.ProviderCatalog.Action.Disable"]
                            </FluentButton>
                        }
                        else
                        {
                            <FluentButton Disabled="_busy || _pendingRestoring || _storeUnavailable || IsPending(context.ProviderId, context.ModelId)" OnClick="@(() => SubmitLifecycleAsync(context, enable: true))" data-testid="agents-provider-catalog-enable">
                                @Localizer["Agents.ProviderCatalog.Action.Enable"]
                            </FluentButton>
                        }
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        }
    </Body>
</FcAggregateListPage>

@code {
    private const string HeadingId = "agents-provider-catalog-heading";
    private const string CatalogPendingFamily = "ProviderCatalogMutation";
    private const string EnablementPendingFamily = "TenantProviderEnablement";
    private static readonly TimeSpan ProjectionPollingTimeout = TimeSpan.FromSeconds(8);
    private static readonly TimeSpan ProjectionPollingInterval = TimeSpan.FromMilliseconds(200);

    private static readonly GridSort<ProviderCatalogEntryView> _sortByProvider =
        GridSort<ProviderCatalogEntryView>.ByAscending(entry => entry.ProviderId).ThenAscending(entry => entry.ModelId);

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private FcAggregateListPage<ProviderCatalogEntryView>? _listPage;
    private ProviderCatalogInspectionResult? _result;
    private ProviderCatalogWriteResult? _pendingWrite;
    private readonly Dictionary<string, (ProviderCatalogCommandAcceptance Acceptance, int? ExpectedCapabilityVersion,
        ProviderModelStatus? ExpectedStatus)> _pendingCatalogCommands = new(StringComparer.Ordinal);
    private AgentSetupTruthState _writeTruth = AgentSetupTruthState.Unknown;
    private bool _selectableOnly;
    private bool _focusHeadingPending = true;
    private bool _busy;
    private bool _pendingRestoring = true;
    private bool _storeUnavailable;
    private bool _disposed;
    private bool _editorOpen;
    private bool _editing;
    private int? _expectedCapabilityVersion;
    private string _providerId = string.Empty;
    private string _modelId = string.Empty;
    private string _displayLabel = string.Empty;
    private string _currency = "USD";
    private string _inputPrice = "0";
    private string _outputPrice = "0";
    private string _contextWindow = "128000";
    private string _maxOutput = "16000";
    private string _timeoutMs = "30000";
    private string _maxRetries = "3";
    private string _configurationReference = string.Empty;
    private bool _clearConfigurationReference;
    private bool _supportsTextGeneration = true;
    private bool _createEnabled = true;
    private bool _supportsStreaming;
    private bool _supportsToolCalling;
    private bool _supportsVision;
    private bool _supportsStructuredOutput;
    private string _retentionDays = string.Empty;
    private bool _trainingUse;
    private string _processingRegions = string.Empty;
    private string _termsReference = string.Empty;
    private bool _declareTightening;
    private ProviderCatalogEntryView? _editingEntry;
    private ProviderCatalogEntryView? _enablementEntry;
    private ProviderCatalogWriteResult? _enablementWrite;
    private string? _enablementTruth;
    private string _enablementTenantId = string.Empty;
    private string _enablementExpectedRevision = "0";
    private bool _enablementEnabled = true;
    private readonly Dictionary<string, string> _pendingEnablementCommands = new(StringComparer.Ordinal);

    private string? SelectedEnablementKey => _enablementEntry is null || string.IsNullOrWhiteSpace(_enablementTenantId)
        ? null : $"{_enablementTenantId.Trim()}:{ProviderCatalogIdentity.EntryId(_enablementEntry.ProviderId, _enablementEntry.ModelId)}";

    private bool PendingSelectedEnablement => SelectedEnablementKey is { } key && _pendingEnablementCommands.ContainsKey(key);

    private IReadOnlyList<ProviderCatalogEntryView> VisibleRows
        => _result is { Status: ProviderCatalogInspectionStatus.Success }
            ? (_selectableOnly
                ? _result.Entries.Where(entry => entry.IsSelectableForNewActiveUse).ToArray()
                : _result.Entries)
            : [];

    private bool ShowGrid => VisibleRows.Count > 0;

    private AgentSetupTruthState DisplayedWriteTruth
        => _writeTruth;

    private bool IsPending(string providerId, string modelId)
        => !string.IsNullOrWhiteSpace(providerId) && !string.IsNullOrWhiteSpace(modelId)
            && _pendingCatalogCommands.ContainsKey(ProviderCatalogIdentity.EntryId(providerId, modelId));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _result = await Gateway
                .ListEntriesAsync(includeDisabled: true, expectedProjectionVersion: null, _lifetimeCancellation.Token)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                foreach (PendingProviderCommand pending in await PendingCommands.LoadAsync(_lifetimeCancellation.Token))
                {
                    if (pending.Family == CatalogPendingFamily)
                    {
                        _pendingCatalogCommands[pending.ResourceKey] = (pending.Acceptance,
                            pending.ExpectedCapabilityVersion, pending.ExpectedStatus);
                        _pendingWrite ??= ProviderCatalogWriteResult.Submitted(pending.Acceptance);
                        _writeTruth = AgentSetupTruthState.AuthoritativePending;
                    }
                    else if (pending.Family == EnablementPendingFamily)
                    {
                        _pendingEnablementCommands[pending.ResourceKey] = pending.Acceptance.MessageId;
                        if (_enablementEntry is null)
                        {
                            _enablementEntry = _result?.Entries.FirstOrDefault(entry =>
                                entry.ProviderId == pending.Acceptance.ProviderId
                                && entry.ModelId == pending.Acceptance.ModelId);
                            _enablementTenantId = pending.TenantId;
                            _enablementTruth = "AuthoritativePending";
                        }
                    }
                }
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                _storeUnavailable = true;
            }
            finally
            {
                _pendingRestoring = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        if (_focusHeadingPending && _listPage is not null)
        {
            _focusHeadingPending = false;
            await _listPage.FocusHeadingAsync().ConfigureAwait(false);
        }
    }

    private void ResetFilters() => _selectableOnly = false;

    private void BeginEnablement(ProviderCatalogEntryView entry)
    {
        _enablementEntry = entry;
        _enablementWrite = null;
        _enablementTruth = null;
        _enablementTenantId = string.Empty;
        _enablementExpectedRevision = "0";
        _enablementEnabled = true;
    }

    private void OnEnablementTenantChanged()
    {
        _enablementWrite = null;
        _enablementExpectedRevision = "0";
        _enablementEnabled = true;
        _enablementTruth = PendingSelectedEnablement ? "AuthoritativePending" : null;
    }

    private async Task SubmitEnablementAsync()
    {
        if (_busy || _pendingRestoring || _storeUnavailable || _enablementEntry is null || PendingSelectedEnablement
            || (_enablementEnabled && _enablementEntry.DataHandling is not { DataHandlingVersion: >= 1 }))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_enablementTenantId)
            || string.Equals(_enablementTenantId.Trim(), "system", StringComparison.Ordinal)
            || !int.TryParse(_enablementExpectedRevision, NumberStyles.Integer, CultureInfo.InvariantCulture, out int revision)
            || revision < 0)
        {
            _enablementWrite = ProviderCatalogWriteResult.Failed(AgentSetupWriteStatus.ValidationFailed);
            return;
        }

        _busy = true;
        try
        {
            string tenantId = _enablementTenantId.Trim();
            string providerId = _enablementEntry.ProviderId;
            string modelId = _enablementEntry.ModelId;
            string pendingKey = $"{tenantId}:{ProviderCatalogIdentity.EntryId(providerId, modelId)}";
            _enablementWrite = await Gateway.SetTenantEnablementAsync(
                new SetTenantProviderModelEnablement(tenantId, providerId,
                    modelId, _enablementEnabled, revision,
                    _enablementEnabled ? _enablementEntry.DataHandling : null),
                _lifetimeCancellation.Token).ConfigureAwait(false);
            if (_enablementWrite.Status is AgentSetupWriteStatus.Submitted)
            {
                _enablementTruth = _enablementWrite.Acceptance?.TruthState == AgentSetupTruthState.ProjectionConfirmed
                    ? "ProjectionConfirmed" : "Submitted";
                if (_enablementTruth == "ProjectionConfirmed")
                {
                    return;
                }

                ProviderCatalogCommandAcceptance? acceptance = _enablementWrite.Acceptance;
                if (acceptance is null)
                {
                    _enablementWrite = ProviderCatalogWriteResult.Failed(AgentSetupWriteStatus.UnableToVerify);
                    return;
                }

                _pendingEnablementCommands[pendingKey] = acceptance.MessageId;
                await PendingCommands.SaveAsync(new PendingProviderCommand(EnablementPendingFamily,
                    pendingKey, tenantId, acceptance), _lifetimeCancellation.Token);

                await RequestRenderAsync(_lifetimeCancellation.Token);
                using CancellationTokenSource timeout = new(ProjectionPollingTimeout, TimeProvider);
                using CancellationTokenSource polling = CancellationTokenSource.CreateLinkedTokenSource(
                    _lifetimeCancellation.Token, timeout.Token);
                try
                {
                    while (true)
                    {
                        AgentSetupWriteStatus outcome = await Gateway.GetCommandOutcomeAsync(
                            tenantId, acceptance.MessageId, polling.Token).ConfigureAwait(false);
                        if (outcome is AgentSetupWriteStatus.Rejected or AgentSetupWriteStatus.Unavailable)
                        {
                            await RemovePendingEnablementAsync(pendingKey, acceptance.MessageId);
                            _enablementWrite = ProviderCatalogWriteResult.Failed(outcome);
                            _enablementTruth = null;
                            break;
                        }

                        if (outcome == AgentSetupWriteStatus.AlreadyApplied)
                        {
                            await RemovePendingEnablementAsync(pendingKey, acceptance.MessageId);
                            _enablementTruth = "ProjectionConfirmed";
                            break;
                        }

                        TenantProviderEnablementInspectionResult current = await Gateway.GetTenantEnablementAsync(
                            tenantId, providerId, modelId,
                            polling.Token).ConfigureAwait(false);
                        bool confirmed = current?.ProjectedCommandMessageIds?.Contains(acceptance.MessageId, StringComparer.Ordinal) == true
                            && outcome == AgentSetupWriteStatus.AwaitingProjection;
                        _enablementTruth = confirmed ? "ProjectionConfirmed" : "AuthoritativePending";
                        if (confirmed)
                        {
                            await RemovePendingEnablementAsync(pendingKey, acceptance.MessageId);
                            break;
                        }

                        await RequestRenderAsync(polling.Token);
                        await Task.Delay(ProjectionPollingInterval, TimeProvider, polling.Token).ConfigureAwait(false);
                    }
                }
                catch (OperationCanceledException) when (timeout.IsCancellationRequested && !_lifetimeCancellation.IsCancellationRequested)
                {
                    _enablementTruth = "AuthoritativePending";
                }
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _storeUnavailable = true;
            _enablementTruth = "AuthoritativePending";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckPendingEnablementAsync()
    {
        if (_busy || _enablementEntry is null || SelectedEnablementKey is not { } key
            || !_pendingEnablementCommands.TryGetValue(key, out string? messageId))
        {
            return;
        }

        _busy = true;
        try
        {
            AgentSetupWriteStatus outcome = await Gateway.GetCommandOutcomeAsync(
                _enablementTenantId.Trim(), messageId, _lifetimeCancellation.Token).ConfigureAwait(false);
            if (outcome is AgentSetupWriteStatus.Rejected or AgentSetupWriteStatus.Unavailable)
            {
                await RemovePendingEnablementAsync(key, messageId);
                _enablementWrite = ProviderCatalogWriteResult.Failed(outcome);
                _enablementTruth = null;
                return;
            }

            if (outcome == AgentSetupWriteStatus.AlreadyApplied)
            {
                await RemovePendingEnablementAsync(key, messageId);
                _enablementTruth = "ProjectionConfirmed";
                return;
            }

            TenantProviderEnablementInspectionResult current = await Gateway.GetTenantEnablementAsync(
                _enablementTenantId.Trim(), _enablementEntry.ProviderId, _enablementEntry.ModelId,
                _lifetimeCancellation.Token).ConfigureAwait(false);
            if (outcome == AgentSetupWriteStatus.AwaitingProjection
                && current?.ProjectedCommandMessageIds?.Contains(messageId, StringComparer.Ordinal) == true)
            {
                await RemovePendingEnablementAsync(key, messageId);
                _enablementTruth = "ProjectionConfirmed";
            }
            else
            {
                _enablementTruth = "AuthoritativePending";
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _storeUnavailable = true;
            _enablementTruth = "AuthoritativePending";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadEnablementRevisionAsync()
    {
        if (_busy || _enablementEntry is null || string.IsNullOrWhiteSpace(_enablementTenantId)
            || string.Equals(_enablementTenantId.Trim(), "system", StringComparison.Ordinal))
        {
            return;
        }

        _busy = true;
        try
        {
            TenantProviderEnablementInspectionResult current = await Gateway.GetTenantEnablementAsync(
                _enablementTenantId.Trim(), _enablementEntry.ProviderId, _enablementEntry.ModelId,
                _lifetimeCancellation.Token).ConfigureAwait(false);
            if ((current.Status is ProviderCatalogInspectionStatus.Success or ProviderCatalogInspectionStatus.EntryNotFound)
                && current.Revision is { } revision)
            {
                _enablementTruth = null;
                _enablementExpectedRevision = revision.ToString(CultureInfo.InvariantCulture);
                if (current.Enabled is { } enabled)
                {
                    _enablementEnabled = enabled;
                }
            }
            else if (current.TruthState == AgentSetupTruthState.AuthoritativePending)
            {
                _enablementTruth = "AuthoritativePending";
            }
        }
        finally
        {
            _busy = false;
        }
    }

