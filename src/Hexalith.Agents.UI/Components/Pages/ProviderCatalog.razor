    private Task SubmitEditorAsync()
    {
        string providerId = _providerId;
        string modelId = _modelId;
        int? expectedCapabilityVersion = _editing ? _expectedCapabilityVersion + 1 : 1;
        return SubmitAsync(
            async ct =>
            {
                bool requiresTerms = (_editing
                        ? _editingEntry is { Status: ProviderModelStatus.Enabled } or { DataHandling: not null }
                        : _createEnabled)
                    || !string.IsNullOrWhiteSpace(_retentionDays)
                    || !string.IsNullOrWhiteSpace(_processingRegions)
                    || !string.IsNullOrWhiteSpace(_termsReference)
                    || _trainingUse;
                ProviderDataHandlingRecord? dataHandling = null;
                if (!TryBuildPricing(out ProviderModelPricing? pricing) || pricing is null
                    || requiresTerms && (!TryBuildDataHandling(out dataHandling) || dataHandling is null)
                    || !TryBuildLimits(out int contextWindow, out int maxOutput, out ProviderModelTimeoutPolicy? timeout)
                    || timeout is null)
                {
                    return ProviderCatalogWriteResult.Failed(AgentSetupWriteStatus.ValidationFailed);
                }

                string? configurationReference = _clearConfigurationReference
                    ? null
                    : string.IsNullOrWhiteSpace(_configurationReference)
                        ? _editingEntry?.ConfigurationReferenceId
                        : _configurationReference.Trim();
                ProviderModelCapabilityFlags flags = ProviderModelCapabilityFlags.None;
                if (_supportsStreaming)
                {
                    flags |= ProviderModelCapabilityFlags.Streaming;
                }
                if (_supportsToolCalling)
                {
                    flags |= ProviderModelCapabilityFlags.ToolCalling;
                }
                if (_supportsVision)
                {
                    flags |= ProviderModelCapabilityFlags.Vision;
                }
                if (_supportsStructuredOutput)
                {
                    flags |= ProviderModelCapabilityFlags.StructuredOutput;
                }
                bool supportsTextGeneration = _supportsTextGeneration;

                if (_editing)
                {
                    return await Gateway.UpdateAsync(
                        new UpdateProviderModelEntry(
                            providerId,
                            modelId,
                            _displayLabel,
                            supportsTextGeneration,
                            contextWindow,
                            maxOutput,
                            timeout,
                            flags,
                            configurationReference,
                            pricing,
                            _expectedCapabilityVersion,
                            dataHandling,
                            _declareTightening),
                        ct).ConfigureAwait(false);
                }

                return await Gateway.CreateAsync(
                    new CreateProviderModelEntry(
                        providerId,
                        modelId,
                        _displayLabel,
                        Enabled: _createEnabled,
                        supportsTextGeneration,
                        contextWindow,
                        maxOutput,
                        timeout,
                        flags,
                        configurationReference,
                        pricing,
                        dataHandling),
                    ct).ConfigureAwait(false);
            },
            providerId,
            modelId,
            expectedCapabilityVersion,
            expectedStatus: null);
    }

    private Task SubmitLifecycleAsync(ProviderCatalogEntryView entry, bool enable)
        => SubmitAsync(
            ct => enable
                ? Gateway.EnableAsync(new EnableProviderModelEntry(entry.ProviderId, entry.ModelId, entry.LifecycleRevision), ct)
                : Gateway.DisableAsync(new DisableProviderModelEntry(entry.ProviderId, entry.ModelId, entry.LifecycleRevision), ct),
            entry.ProviderId,
            entry.ModelId,
            expectedCapabilityVersion: null,
            expectedStatus: enable ? ProviderModelStatus.Enabled : ProviderModelStatus.Disabled);

    private async Task SubmitAsync(
        Func<CancellationToken, Task<ProviderCatalogWriteResult>> write,
        string providerId,
        string modelId,
        int? expectedCapabilityVersion,
        ProviderModelStatus? expectedStatus)
    {
        if (string.IsNullOrWhiteSpace(providerId) || string.IsNullOrWhiteSpace(modelId))
        {
            _pendingWrite = ProviderCatalogWriteResult.Failed(AgentSetupWriteStatus.ValidationFailed);
            return;
        }

        string entryKey = ProviderCatalogIdentity.EntryId(providerId, modelId);
        if (_busy || _pendingRestoring || _storeUnavailable || _pendingCatalogCommands.ContainsKey(entryKey))
        {
            return;
        }

        _busy = true;
        ProviderCatalogWriteResult? writeResult = null;
        try
        {
            CancellationToken cancellationToken = _lifetimeCancellation.Token;
            writeResult = await write(cancellationToken).WaitAsync(cancellationToken).ConfigureAwait(false);
            cancellationToken.ThrowIfCancellationRequested();
            _pendingWrite = writeResult;
            if (_pendingWrite.Status is AgentSetupWriteStatus.Submitted)
            {
                _writeTruth = _pendingWrite.Acceptance?.TruthState ?? AgentSetupTruthState.Submitted;
                _editorOpen = false;
                await RequestRenderAsync(cancellationToken).ConfigureAwait(false);
                if (_writeTruth != AgentSetupTruthState.ProjectionConfirmed
                    && _pendingWrite.Acceptance is { } acceptance)
                {
                    _pendingCatalogCommands[entryKey] = (acceptance, expectedCapabilityVersion, expectedStatus);
                    await PendingCommands.SaveAsync(new PendingProviderCommand(CatalogPendingFamily,
                        entryKey, "system", acceptance, expectedCapabilityVersion, expectedStatus), cancellationToken);
                    await RefreshAfterWriteAsync(providerId, modelId, expectedCapabilityVersion,
                        expectedStatus, acceptance, cancellationToken).ConfigureAwait(false);
                }
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception)
        {
            if (!_disposed && writeResult is { Status: AgentSetupWriteStatus.Submitted })
            {
                _storeUnavailable = true;
                _writeTruth = AgentSetupTruthState.AuthoritativePending;
            }
            else if (!_disposed)
            {
                _pendingWrite = ProviderCatalogWriteResult.Failed(AgentSetupWriteStatus.Unavailable);
            }
        }
        finally
        {
            if (!_disposed)
            {
                _busy = false;
            }
        }
    }

    private async Task RefreshAfterWriteAsync(
        string providerId,
        string modelId,
        int? expectedCapabilityVersion,
        ProviderModelStatus? expectedStatus,
        ProviderCatalogCommandAcceptance acceptance,
        CancellationToken cancellationToken)
    {
        using CancellationTokenSource timeoutCancellation = new(ProjectionPollingTimeout, TimeProvider);
        using CancellationTokenSource pollingCancellation = CancellationTokenSource.CreateLinkedTokenSource(
            cancellationToken,
            timeoutCancellation.Token);
        try
        {
            while (true)
            {
                AgentSetupWriteStatus outcome = await Gateway.GetCommandOutcomeAsync(
                    "system", acceptance.MessageId, pollingCancellation.Token).ConfigureAwait(false);
                if (outcome is AgentSetupWriteStatus.Rejected or AgentSetupWriteStatus.Unavailable)
                {
                    await RemovePendingCatalogAsync(providerId, modelId, acceptance.MessageId, cancellationToken);
                    _pendingWrite = ProviderCatalogWriteResult.Failed(outcome);
                    _writeTruth = AgentSetupTruthState.Unknown;
                    return;
                }

                if (outcome == AgentSetupWriteStatus.AlreadyApplied)
                {
                    await RemovePendingCatalogAsync(providerId, modelId, acceptance.MessageId, cancellationToken);
                    _writeTruth = AgentSetupTruthState.ProjectionConfirmed;
                    return;
                }

                bool projected = await LoadAfterWriteAsync(providerId, modelId,
                    expectedCapabilityVersion, expectedStatus, acceptance.MessageId, pollingCancellation.Token)
                    .ConfigureAwait(false);
                if (projected && outcome == AgentSetupWriteStatus.AwaitingProjection)
                {
                    await RemovePendingCatalogAsync(providerId, modelId, acceptance.MessageId, cancellationToken);
                    _writeTruth = AgentSetupTruthState.ProjectionConfirmed;
                    return;
                }

                _writeTruth = AgentSetupTruthState.AuthoritativePending;
                await RequestRenderAsync(pollingCancellation.Token).ConfigureAwait(false);
                await Task.Delay(ProjectionPollingInterval, TimeProvider, pollingCancellation.Token).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (
            timeoutCancellation.IsCancellationRequested && !cancellationToken.IsCancellationRequested)
        {
            _writeTruth = AgentSetupTruthState.AuthoritativePending;
        }
    }

    private async Task CheckPendingCatalogAsync(string entryKey)
    {
        if (_busy || !_pendingCatalogCommands.TryGetValue(entryKey, out var pending))
        {
            return;
        }

        _busy = true;
        try
        {
            ProviderCatalogCommandAcceptance acceptance = pending.Acceptance;
            AgentSetupWriteStatus outcome = await Gateway.GetCommandOutcomeAsync(
                "system", acceptance.MessageId, _lifetimeCancellation.Token).ConfigureAwait(false);
            if (outcome is AgentSetupWriteStatus.Rejected or AgentSetupWriteStatus.Unavailable)
            {
                await RemovePendingCatalogAsync(acceptance.ProviderId, acceptance.ModelId,
                    acceptance.MessageId, _lifetimeCancellation.Token);
                _pendingWrite = ProviderCatalogWriteResult.Failed(outcome);
                _writeTruth = AgentSetupTruthState.Unknown;
                return;
            }

            if (outcome == AgentSetupWriteStatus.AlreadyApplied)
            {
                await RemovePendingCatalogAsync(acceptance.ProviderId, acceptance.ModelId,
                    acceptance.MessageId, _lifetimeCancellation.Token);
                _writeTruth = AgentSetupTruthState.ProjectionConfirmed;
                return;
            }

            bool projected = await LoadAfterWriteAsync(acceptance.ProviderId, acceptance.ModelId,
                pending.ExpectedCapabilityVersion, pending.ExpectedStatus, acceptance.MessageId,
                _lifetimeCancellation.Token).ConfigureAwait(false);
            if (projected && outcome == AgentSetupWriteStatus.AwaitingProjection)
            {
                await RemovePendingCatalogAsync(acceptance.ProviderId, acceptance.ModelId,
                    acceptance.MessageId, _lifetimeCancellation.Token);
                _writeTruth = AgentSetupTruthState.ProjectionConfirmed;
            }
            else
            {
                _writeTruth = AgentSetupTruthState.AuthoritativePending;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _storeUnavailable = true;
            _writeTruth = AgentSetupTruthState.AuthoritativePending;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemovePendingEnablementAsync(string key, string messageId)
    {
        await PendingCommands.RemoveAsync(EnablementPendingFamily, key, messageId, _lifetimeCancellation.Token);
        _pendingEnablementCommands.Remove(key);
    }

    private async Task RemovePendingCatalogAsync(string providerId, string modelId,
        string messageId, CancellationToken cancellationToken)
    {
        string key = ProviderCatalogIdentity.EntryId(providerId, modelId);
        await PendingCommands.RemoveAsync(CatalogPendingFamily, key, messageId, cancellationToken);
        _pendingCatalogCommands.Remove(key);
    }

    private async Task<bool> LoadAfterWriteAsync(
        string providerId,
        string modelId,
        int? expectedCapabilityVersion,
        ProviderModelStatus? expectedStatus,
        string messageId,
        CancellationToken cancellationToken)
    {
        ProviderCatalogInspectionResult entry = await Gateway
            .GetEntryAsync(providerId, modelId, expectedCapabilityVersion, cancellationToken)
            .WaitAsync(cancellationToken)
            .ConfigureAwait(false);
        cancellationToken.ThrowIfCancellationRequested();

        if (entry.Status is ProviderCatalogInspectionStatus.NotAuthorized)
        {
            _result = entry;
            return false;
        }

        ProviderCatalogInspectionResult list = await Gateway
            .ListEntriesAsync(includeDisabled: true, entry.ProjectionVersion, cancellationToken)
            .WaitAsync(cancellationToken)
            .ConfigureAwait(false);
        cancellationToken.ThrowIfCancellationRequested();

        if (list.Status is not ProviderCatalogInspectionStatus.Success)
        {
            _result = list;
            return false;
        }

        bool caughtUp = entry.ProjectedCommandMessageIds?.Contains(messageId, StringComparer.Ordinal) == true;
        _result = list;
        return caughtUp;
    }

    private Task RequestRenderAsync(CancellationToken cancellationToken)
        => InvokeAsync(() =>
        {
            cancellationToken.ThrowIfCancellationRequested();
            StateHasChanged();
        });

    private bool TryBuildPricing(out ProviderModelPricing? pricing)
    {
        pricing = null;
        string currency = _currency.Trim();
        if (currency.Length != 3
            || !char.IsAsciiLetter(currency[0])
            || !char.IsAsciiLetter(currency[1])
            || !char.IsAsciiLetter(currency[2])
            || !decimal.TryParse(_inputPrice, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal input)
            || !decimal.TryParse(_outputPrice, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal output)
            || input < 0
            || output < 0)
        {
            return false;
        }

        pricing = new ProviderModelPricing(currency, input, output, PricingVersion: 0);
        return true;
    }

    private bool TryBuildDataHandling(out ProviderDataHandlingRecord? record)
    {
        record = null;
        if (!int.TryParse(_retentionDays, NumberStyles.Integer, CultureInfo.InvariantCulture, out int days)
            || days < 0
            || string.IsNullOrWhiteSpace(_termsReference))
        {
            return false;
        }

        string[] regions = _processingRegions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (regions.Length == 0 || regions.Any(string.IsNullOrWhiteSpace))
        {
            return false;
        }

        record = new ProviderDataHandlingRecord(days, _trainingUse, regions, _termsReference.Trim(), 0);
        return true;
    }

    private bool TryBuildLimits(out int contextWindow, out int maxOutput, out ProviderModelTimeoutPolicy? timeout)
    {
        contextWindow = 0;
        maxOutput = 0;
        timeout = null;
        if (!int.TryParse(_contextWindow, NumberStyles.Integer, CultureInfo.InvariantCulture, out contextWindow)
            || !int.TryParse(_maxOutput, NumberStyles.Integer, CultureInfo.InvariantCulture, out maxOutput)
            || !int.TryParse(_timeoutMs, NumberStyles.Integer, CultureInfo.InvariantCulture, out int timeoutMs)
            || !int.TryParse(_maxRetries, NumberStyles.Integer, CultureInfo.InvariantCulture, out int retries))
        {
            return false;
        }

        timeout = new ProviderModelTimeoutPolicy(timeoutMs, retries);
        return true;
    }

    private string PricingLabel(ProviderCatalogEntryView entry)
        => entry.Pricing is { } pricing
            ? Localizer["Agents.ProviderCatalog.Pricing.Value", pricing.Currency, pricing.InputTokenUnitPrice, pricing.OutputTokenUnitPrice, pricing.PricingVersion]
            : Localizer["Agents.ProviderCatalog.Pricing.Missing"];

    private IEnumerable<string> CapabilityLabels(ProviderCatalogEntryView entry)
    {
        if (entry.SupportsTextGeneration)
        {
            yield return Localizer["Agents.ProviderCatalog.Capability.TextGeneration"];
        }

        if (entry.SafeCapabilityFlags == ProviderModelCapabilityFlags.None && !entry.SupportsTextGeneration)
        {
            yield return Localizer["Agents.ProviderCatalog.Capability.None"];
            yield break;
        }

        foreach (ProviderModelCapabilityFlags flag in _optionalCapabilityFlags)
        {
            if (entry.SafeCapabilityFlags.HasFlag(flag))
            {
                yield return Localizer[$"Agents.ProviderCatalog.Capability.{flag}"];
            }
        }
    }

    private static readonly ProviderModelCapabilityFlags[] _optionalCapabilityFlags =
    [
        ProviderModelCapabilityFlags.Streaming,
        ProviderModelCapabilityFlags.ToolCalling,
        ProviderModelCapabilityFlags.Vision,
        ProviderModelCapabilityFlags.StructuredOutput,
    ];

    /// <inheritdoc />
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetimeCancellation.Cancel();
        _lifetimeCancellation.Dispose();
    }
