<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Hexalith1BuildPackageProps Condition="'$(Hexalith1BuildPackageProps)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
  </PropertyGroup>
  <Import Project="$(Hexalith1BuildPackageProps)" Condition="Exists('$(Hexalith1BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <!-- Only the package versions the buildable shell + boundary-guard tests consume today. Future
       Agent/provider/Aspire packages are added by the stories that need them (AC4: no premature
       pre-listing). Versions follow the architecture Stack table. -->
  <ItemGroup Label="UI">
    <!-- FluentUI Blazor v5 — the FrontComposer-governed baseline (matches Hexalith.Tenants). The Agents
         admin-setup UI (Story 1.8) inherits Fluent semantic roles/components; do not pin a different version. -->
    <PackageVersion Update="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0-rc.4-26180.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Update="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Update="xunit.v3" Version="3.2.2" />
    <PackageVersion Update="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Update="Shouldly" Version="4.3.0" />
    <PackageVersion Update="NSubstitute" Version="5.3.0" />
    <PackageVersion Update="coverlet.collector" Version="10.0.1" />
    <!-- bUnit for the Agents.UI component/conformance/a11y tests (Story 1.8; matches Hexalith.Tenants). -->
    <PackageVersion Update="bunit" Version="2.8.6" />
  </ItemGroup>
</Project>
