<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Agents.EventStore\Hexalith.Agents.EventStore.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Agents.Server\Hexalith.Agents.Server.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup Condition="'$(HexalithConversationsFromSource)' != 'true'">
    <Compile Remove="ConversationClientContextReaderTests.cs" />
    <Compile Remove="ConversationClientResponsePosterTests.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HexalithPartiesFromSource)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_PARTIES_SOURCE</DefineConstants>
  </PropertyGroup>

  <!-- Published Client 3.127.0 lacks exact-domain assertion delegation. Package mode refuses status credentials
       until a compatible SDK is pinned; source mode binds only the declared domain through the owner API. -->
  <PropertyGroup Condition="'$(HexalithEventStoreFromSource)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_EVENTSTORE_DOMAIN_ASSERTIONS</DefineConstants>
  </PropertyGroup>
</Project>
