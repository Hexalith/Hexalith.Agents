<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Agents.EventStore\Hexalith.Agents.EventStore.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Agents.Server\Hexalith.Agents.Server.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup Condition="'$(HexalithConversationsFromSource)' != 'true'">
    <!-- Exercise the same source adapters against the approved package catalog while the Release host keeps its deferred bindings. -->
    <PackageReference Include="Hexalith.Conversations.Client" />
    <Compile Include="../../src/Hexalith.Agents.Server/Ports/ConversationClientContextReader.cs" Link="Ports/ConversationClientContextReader.cs" />
    <Compile Include="../../src/Hexalith.Agents.Server/Ports/ConversationClientResponsePoster.cs" Link="Ports/ConversationClientResponsePoster.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HexalithPartiesFromSource)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_PARTIES_SOURCE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);HEXALITH_EVENTSTORE_SOURCE</DefineConstants>
  </PropertyGroup>

</Project>
