<HexalithSourceMappingActiveModule>Hexalith.Agents</HexalithSourceMappingActiveModule>
<HexalithSourceMappingHasGit>true</HexalithSourceMappingHasGit>
<Configuration>Debug</Configuration>
<UseHexalithProjectReferences>true</UseHexalithProjectReferences>
<UseNuGetDeps>false</UseNuGetDeps>
<HexalithAgentsRoot>/home/administrator/projects/hexalith/agents</HexalithAgentsRoot>
