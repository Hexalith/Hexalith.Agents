<Project>
<PropertyGroup>
<HexalithSourceMappingApplies Condition="!$([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('/tmp/agents-caller-identity-mapping/hosts/', System.StringComparison.Ordinal))">true</HexalithSourceMappingApplies>
</PropertyGroup><PropertyGroup Condition="'$(HexalithSourceMappingApplies)' == 'true'">
<HexalithSourceMappingMode>source</HexalithSourceMappingMode>
