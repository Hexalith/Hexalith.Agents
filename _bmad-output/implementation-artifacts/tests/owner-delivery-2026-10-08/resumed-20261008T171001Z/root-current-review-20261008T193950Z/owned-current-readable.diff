+                if (snapshot.Batch.BlockSetRevision <= 0 || string.IsNullOrWhiteSpace(snapshot.Batch.ProtectionReceiptId) || string.IsNullOrWhiteSpace(snapshot.Batch.IssueReceiptId)) { return new("ReplacementBlockUnverified", signed); }
