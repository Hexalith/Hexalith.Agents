+        f.AttemptCommands.Count.ShouldBe(2);
+        f.AttemptCommands.Select(c => c.Signal).Distinct().Count().ShouldBe(1);
+        f.AttemptCommands.Select(c => c.DeliveryAttemptId).Distinct().Count().ShouldBe(2);
