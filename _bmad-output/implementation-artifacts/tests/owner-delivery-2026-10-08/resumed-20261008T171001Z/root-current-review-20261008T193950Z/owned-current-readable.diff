+        (await recorder.ObserveAsync("original-server-receipt", "invalid-tag", ["secret"], "key-v1", envelope, identity, TestContext.Current.CancellationToken)).ShouldBe(original);
+        fixture.Read()!.Records.Count.ShouldBe(1);
