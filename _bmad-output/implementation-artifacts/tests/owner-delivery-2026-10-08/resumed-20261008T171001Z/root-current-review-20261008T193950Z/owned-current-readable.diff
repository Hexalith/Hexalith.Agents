+            || !await authority.AuthorizeOperationAsync(payload, id, "RecoverSigningSuccessor").ConfigureAwait(false)
+            || DeletionCapabilitySigningSuccessor.Create(original, final, _clock.GetUtcNow()) is null) { return null; }
