+        exception.CancellationToken.ShouldBe(caller.Token); visited.ShouldBe([1L, 2L, 3L, 1L, 2L, 3L]);
+        f.Read()!.Entries.Select(e => e.Publication.PublicationId).ShouldBe(["publication-1", "publication-2", "publication-3"]);
+    }
