+            var snapshot = await WaitAsync(() => guard.ReadAsync(payload, providerCancellation.Token)).ConfigureAwait(false);
+            if (snapshot is null || snapshot.Batch.Capability != payload || snapshot.Batch.DetachedJws != signed.DetachedJws
