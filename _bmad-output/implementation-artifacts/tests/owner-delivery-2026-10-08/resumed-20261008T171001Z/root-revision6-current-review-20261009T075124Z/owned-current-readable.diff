+            "null-ciphertext" => wrapped with { Ciphertext = null! },
+            _ => wrapped with { Tag = null! },
+        };
+        Should.Throw<CryptographicException>(() => ExportKeyWrappingCore.Unwrap(WrapContext, invalid, kek));
+    }
+
