+            Arg.Any<IReadOnlyDictionary<string, string>>(), Arg.Any<CancellationToken>()).Returns(call =>
+        {
+            lock (Stored)
+            {
+                var cell = Stored.TryGetValue(call.ArgAt<string>(1), out var value) ? JsonSerializer.Deserialize<GuardedStateCell>(value) : null;
