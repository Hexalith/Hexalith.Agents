+            providerToken.IsCancellationRequested.ShouldBeTrue();
+        }
+        finally
+        {
+            release.Set();
+            pending.TrySetResult(true);
+            await cancelReturned.Task.WaitAsync(TimeSpan.FromSeconds(3), TestContext.Current.CancellationToken);
+        }
