<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Agents</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Agents</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- UseHexalithProjectReferences is the authoritative dependency mode. Ordinary Debug
         work uses sibling source; Release and all other configurations use packages. -->
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == '' and ('$(Configuration)' == '' or '$(Configuration)' == 'Debug')">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == ''">false</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'false'">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'true'">false</UseHexalithProjectReferences>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == '' and '$(UseHexalithProjectReferences)' == 'true'">false</UseNuGetDeps>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == '' and '$(UseHexalithProjectReferences)' == 'false'">true</UseNuGetDeps>

    <!-- Sibling-source resolution (mirrors the Hexalith*Root pattern used across the ecosystem). -->
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.EventStore</HexalithEventStoreRoot>

    <HexalithConversationsRoot Condition="'$(HexalithConversationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Conversations\src\Hexalith.Conversations.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.Conversations</HexalithConversationsRoot>
    <HexalithConversationsRoot Condition="'$(HexalithConversationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Conversations\src\Hexalith.Conversations.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.Conversations</HexalithConversationsRoot>

    <HexalithPartiesRoot Condition="'$(HexalithPartiesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Parties\src\Hexalith.Parties.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.Parties</HexalithPartiesRoot>
    <HexalithPartiesRoot Condition="'$(HexalithPartiesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Parties\src\Hexalith.Parties.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.Parties</HexalithPartiesRoot>

    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Tenants\src\Hexalith.Tenants.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Tenants\src\Hexalith.Tenants.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.Tenants</HexalithTenantsRoot>

    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
    <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer</HexalithFrontComposerRoot>

    <HexalithCommonsRoot Condition="'$(HexalithCommonsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Commons\src\libraries\Hexalith.Commons.UniqueIds')">$(MSBuildThisFileDirectory)references\Hexalith.Commons</HexalithCommonsRoot>
    <HexalithCommonsRoot Condition="'$(HexalithCommonsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Commons\src\libraries\Hexalith.Commons.UniqueIds')">$(MSBuildThisFileDirectory)..\Hexalith.Commons</HexalithCommonsRoot>

    <HexalithEventStoreFromSource Condition="'$(HexalithEventStoreFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithEventStoreRoot)\src\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj')">true</HexalithEventStoreFromSource>
    <HexalithConversationsFromSource Condition="'$(HexalithConversationsFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithConversationsRoot)\src\Hexalith.Conversations.Client\Hexalith.Conversations.Client.csproj')">true</HexalithConversationsFromSource>
    <HexalithPartiesFromSource Condition="'$(HexalithPartiesFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithPartiesRoot)\src\Hexalith.Parties.Client\Hexalith.Parties.Client.csproj')">true</HexalithPartiesFromSource>
    <HexalithTenantsFromSource Condition="'$(HexalithTenantsFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithTenantsRoot)\src\Hexalith.Tenants.Contracts\Hexalith.Tenants.Contracts.csproj')">true</HexalithTenantsFromSource>
    <HexalithFrontComposerFromSource Condition="'$(HexalithFrontComposerFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Shell\Hexalith.FrontComposer.Shell.csproj')">true</HexalithFrontComposerFromSource>
    <HexalithCommonsFromSource Condition="'$(HexalithCommonsFromSource)' == '' and '$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.UniqueIds\Hexalith.Commons.UniqueIds.csproj')">true</HexalithCommonsFromSource>
  </PropertyGroup>

  <Target Name="ValidateDependencyMode" BeforeTargets="Restore;Build;GenerateNuspec;Pack;Publish">
    <Error Condition="'$(UseHexalithProjectReferences)' != 'true' and '$(UseHexalithProjectReferences)' != 'false'" Text="UseHexalithProjectReferences must be either true or false." />
    <Error Condition="'$(UseNuGetDeps)' != 'true' and '$(UseNuGetDeps)' != 'false'" Text="UseNuGetDeps must be either true or false." />
    <Error Condition="'$(UseHexalithProjectReferences)' == '$(UseNuGetDeps)'" Text="Contradictory dependency mode: UseHexalithProjectReferences and UseNuGetDeps must have opposite values." />
    <Error Condition="'$(UseHexalithProjectReferences)' == 'false' and ('$(HexalithEventStoreFromSource)' == 'true' or '$(HexalithConversationsFromSource)' == 'true' or '$(HexalithPartiesFromSource)' == 'true' or '$(HexalithTenantsFromSource)' == 'true' or '$(HexalithFrontComposerFromSource)' == 'true' or '$(HexalithCommonsFromSource)' == 'true')" Text="Package dependency mode rejects forced Hexalith*FromSource=true properties." />
  </Target>

  <Target Name="CheckSourceDependencies" BeforeTargets="Restore;Build" DependsOnTargets="ValidateDependencyMode" Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <Error Condition="'$(HexalithEventStoreFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.EventStore' is missing. Run: git submodule update --init -- references/Hexalith.EventStore from the repository root." />
    <Error Condition="'$(HexalithConversationsFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.Conversations' is missing. Run: git submodule update --init -- references/Hexalith.Conversations from the repository root." />
    <Error Condition="'$(HexalithPartiesFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.Parties' is missing. Run: git submodule update --init -- references/Hexalith.Parties from the repository root." />
    <Error Condition="'$(HexalithTenantsFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.Tenants' is missing. Run: git submodule update --init -- references/Hexalith.Tenants from the repository root." />
    <Error Condition="'$(HexalithFrontComposerFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.FrontComposer' is missing. Run: git submodule update --init -- references/Hexalith.FrontComposer from the repository root." />
    <Error Condition="'$(HexalithCommonsFromSource)' != 'true'" Text="Source dependency 'references/Hexalith.Commons' is missing. Run: git submodule update --init -- references/Hexalith.Commons from the repository root." />
  </Target>

  <ItemGroup>
    <RequiredRootSubmodule Include="Hexalith.Builds" />
  </ItemGroup>

  <Target Name="CheckBuildCatalog" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)references/Hexalith.Builds/.git')" Text="Build catalog submodule 'references/Hexalith.Builds' is missing. Run: git submodule update --init -- references/Hexalith.Builds from the repository root." />
  </Target>

  <Target Name="FailReleaseWithHexalithProjectReferences" BeforeTargets="Restore;Build" DependsOnTargets="ValidateDependencyMode" Condition="'$(Configuration)' != 'Debug' and '$(UseHexalithProjectReferences)' == 'true'">
    <Error Text="Release builds must use package references for external Hexalith libraries. Set UseHexalithProjectReferences=false." />
  </Target>

  <Target Name="FailPackWithHexalithProjectReferences" BeforeTargets="GenerateNuspec;Pack;Publish" DependsOnTargets="ValidateDependencyMode" Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <Error Text="Package creation must not use external Hexalith project references. Set UseHexalithProjectReferences=false." />
  </Target>
</Project>
